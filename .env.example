# MT3 Transcription Configuration
# Copy this to .env and fill in your values

# Django — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# Serve /media/ from Django. DEBUG=True enables this automatically. Leave
# False in production when nginx or object storage handles media.
SERVE_MEDIA=False

# S3-compatible media storage (Cloudflare R2, Linode, AWS S3, etc.). Leave
# bucket empty to store media on the local filesystem under media/.
# See docs/object-storage.md.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_QUERYSTRING_EXPIRE=3600

# Linode Object Storage example:
# AWS_S3_ENDPOINT_URL=https://<cluster>.linodeobjects.com
# AWS_S3_REGION_NAME=us-east-1
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# Public site metadata
FRONTEND_URL=https://pyaar.ai
SITE_DOMAIN=localhost:8008
SITE_NAME=whats-the-tab

# Comma-separated deployment hosts/origins. These replace the defaults when set.
# ALLOWED_HOSTS=your.server.ip,example.com
# CSRF_TRUSTED_ORIGINS=https://example.com
# CORS_ALLOWED_ORIGINS=https://example.com

# Additional allowed hosts/origins (comma-separated, for deployment)
# EXTRA_ALLOWED_HOSTS=your.server.ip
# EXTRA_CSRF_ORIGINS=http://your.server.ip:3000
# EXTRA_CORS_ORIGINS=http://your.server.ip:3000

# HTTPS hardening. Enable these behind a trusted TLS proxy.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Shared secret for worker -> web result callbacks. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
WORKER_SHARED_SECRET=

# Optional API key for client-facing endpoints. Leave empty for an open API
# (rate limits still apply). Send it as X-API-Key or Authorization: Bearer.
TRANSCRIBE_API_KEY=

# Reject audio longer than this (seconds) and uploads larger than this (bytes)
MAX_AUDIO_DURATION_SECONDS=600
MAX_UPLOAD_BYTES=26214400

# Per-IP limits (requests per window)
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_UPLOADS=60
RATE_LIMIT_TRANSCRIPTIONS=20
RATE_LIMIT_YOUTUBE_DOWNLOADS=10

# Async processing (requires Redis and a local worker or Vast dispatcher)
REDIS_URL=redis://localhost:6379

# Vast dispatcher only. Leave VAST_ENDPOINT_NAME empty for local inference.
# VAST_ENDPOINT_NAME=
# VAST_API_KEY=

# Mailgun (for email features)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
